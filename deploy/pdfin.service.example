[Unit]
Description=pdfin Rust PDF processing backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pdfin
Group=pdfin
ExecStart=/opt/pdfin/bin/backend
Restart=on-failure
RestartSec=2

# Contain resource exhaustion from hostile documents without taking the whole host down.
MemoryHigh=2G
MemoryMax=3G
TasksMax=128
LimitNOFILE=8192
CPUQuota=300%

# Keep the HTTP listener private; put a TLS reverse proxy in front for public deployments.
Environment=PDFIN_HOST=127.0.0.1
Environment=PDFIN_PORT=3000
Environment=PDFIN_MAX_REQUEST_MB=500
Environment=PDFIN_REQUEST_TIMEOUT_SECONDS=120
Environment=PDFIN_MAX_CONCURRENCY=4
Environment=PDFIN_MAX_CONVERSION_CONCURRENCY=2
Environment=PDFIN_RATE_LIMIT_PER_MINUTE=60
Environment=PDFIN_RATE_LIMIT_BURST=10
# Only list proxy addresses that you fully control and that sanitize X-Forwarded-For.
# Multiple values may be separated by commas.
Environment=PDFIN_TRUSTED_PROXY_IPS=127.0.0.1

# Least-privilege hardening for untrusted PDF/Office processing.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# The service only needs loopback networking. This also prevents parser
# subprocesses from reaching external networks (SSRF/exfiltration guard).
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
